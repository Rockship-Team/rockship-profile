# RUNTIME env. This file lives ON THE SERVER at the path REMOTE_ENV_FILE points
# to (default /etc/rockship-profile/.env.production) and is passed to the
# container with `docker run --env-file`.
#
# Provision it once by hand — the deploy script never uploads it, so these
# secrets never pass through CI, GitHub, or the image.
#
#   sudo mkdir -p /etc/rockship-profile
#   sudo nano /etc/rockship-profile/.env.production
#   sudo chmod 600 /etc/rockship-profile/.env.production
#
# Read at runtime by the Node server, so changes take effect on container
# restart — no rebuild needed.

# Supabase service role key — bypasses Row Level Security entirely. Treat it
# like a database root password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Credentials for the /admin area.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-a-long-random-value

# Contact form delivery (app/api/contact). Without it the form returns 503.
RESEND_API_KEY=re_xxxxxxxx

# Do NOT add NEXT_PUBLIC_* variables here. Next.js compiles them into the bundle
# at build time, so values set at runtime are silently ignored — they belong in
# .env.production on the build machine instead.
