# BUILD-TIME env. Copy to `.env.production` on the machine that runs
# `./scripts/deploy.sh build` (your laptop, or GitHub secrets in CI).
#
# Everything here is NEXT_PUBLIC_*, which Next.js inlines into the JavaScript
# bundle during `next build`. That means two things:
#   1. It MUST be present at build time — setting it on the server is too late,
#      the value is already compiled in.
#   2. It is PUBLIC. Anyone can read these values from the shipped JS. Never put
#      a secret here. Server-only secrets go in the server's env file instead
#      (see .env.server.example).

# Supabase — OPTIONAL. Leave both blank and the blog renders as empty; the rest
# of the site is unaffected. Placeholder values count as unconfigured, so the
# defaults below behave the same as leaving them blank.
#
# The anon key is designed to be public and is safe here, provided Row Level
# Security is enabled on every table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Analytics 4 measurement ID for the rockship-profile property. Not a
# secret — it is readable in the page source of any site using it. Inlined at
# build time like everything else here, so changing it needs a rebuild.
#
# Set this ONLY for production builds. Leaving it unset locally and in preview
# is deliberate: when unset GA does not load at all, so dev sessions and
# preview deploys never report into production numbers.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-J3SEQ1RW1S

# AI provider keys used to live here as NEXT_PUBLIC_* and shipped to the
# browser. They are now server-only and belong in .env.server.example —
# DASHSCOPE_API_KEY, GROQ_API_KEY, GEMINI_API_KEY.
