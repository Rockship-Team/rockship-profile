# Supabase Configuration
# Get these values from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api

# Project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/Public key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role key (server-side only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Authentication
# These credentials protect the /admin routes
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# Chat assistant — Qwen on Alibaba Cloud Model Studio
# Server-only. None of these may take a NEXT_PUBLIC_ prefix: Next inlines
# NEXT_PUBLIC_* into the client bundle, which is how the previous Groq key
# leaked. Unset, /api/chat returns 503 and the widget shows itself offline.
#
# API key from Model Studio: https://modelstudio.console.alibabacloud.com/
DASHSCOPE_API_KEY=
# OpenAI-compatible endpoint. In ap-southeast-1 (Singapore) the base URL MUST
# include your WorkspaceId as the first segment — without it requests fail
# against the region. This is the dedicated domain Alibaba recommends over
# dashscope-intl.aliyuncs.com.
DASHSCOPE_BASE_URL=https://your-workspace-id.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Model id. Env-driven so switching tier or rolling back is a restart, not a
# deploy. Defaults to qwen-plus.
QWEN_MODEL=qwen-plus

# Voice — Groq (Whisper STT + Orpheus TTS)
# Server-only; proxied through /api/voice/*. Chat moved to Qwen, voice did not.
# Unset, the widget falls back to the browser's Web Speech API.
GROQ_API_KEY=

# Admin blog editor writing assistant — Gemini
# Server-only; proxied through /api/editor-ai. Unset, the editor's AI actions
# return 503; the rest of the editor is unaffected.
GEMINI_API_KEY=

# Google Analytics 4
# Measurement ID for the GA4 data stream, e.g. G-XXXXXXXXXX.
# Not a secret, but keep it per-environment: leave this UNSET locally and in
# preview so dev sessions and preview deploys do not report into production
# numbers. When unset, GA does not load at all.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
